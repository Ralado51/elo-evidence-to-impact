# Copy to .env and fill in. Never commit .env.
# This project handles SYNTHETIC data only.

# Language model (optional; the deterministic fallback runs without it)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=qwen2.5:3b
EXTRACTION_MODE=llm

# Storage
DATABASE_URL=sqlite:///./local_data/elo.sqlite3

# Local patient registry (never sent to any model)
REGISTRY_PATH=./local_data/registry.sqlite3

# App
DEFAULT_LOCALE=pt-BR
LLM_BASE_URL=http://ollama:11434/v1
