# Copy to .env and fill in. Never commit .env.
# This project handles SYNTHETIC data only.

# Language model (optional; the deterministic fallback runs without it)
LLM_API_KEY=ollama
LLM_TIMEOUT=180
# Set for a public deployment; the app asks for it.
ELO_ACCESS_TOKEN=
LLM_MODEL=qwen2.5:3b
EXTRACTION_MODE=llm

# Storage
ELO_DATA_DIR=./local_data

# The patient registry lives in the same directory and is never sent to any model.

# App
DEFAULT_LOCALE=pt-BR
LLM_BASE_URL=http://ollama:11434/v1
