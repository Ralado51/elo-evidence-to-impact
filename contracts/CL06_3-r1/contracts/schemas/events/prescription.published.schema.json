{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "elo:contracts:3.0.0:event.prescription.published",
 "type": "object",
 "properties": {
  "event_id": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "schema_version": {
   "const": 3
  },
  "type": {
   "const": "prescription.published"
  },
  "stream_id": {
   "type": "string",
   "pattern": "^(session|prescription|consent|review|privacy):[A-Za-z0-9_.-]{8,140}$"
  },
  "seq": {
   "type": "integer",
   "minimum": 1,
   "maximum": 1000000000
  },
  "prev_hash": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[0-9a-f]{64}$"
  },
  "occurred_at": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
  },
  "t_mono_ms": {
   "type": "number",
   "minimum": 0,
   "maximum": 1000000000
  },
  "actor": {
   "type": "object",
   "properties": {
    "role": {
     "type": "string",
     "enum": [
      "participant",
      "therapist",
      "system"
     ]
    },
    "id": {
     "type": "string",
     "pattern": "^(p|t|sys)_[A-Za-z0-9-]{8,64}$"
    }
   },
   "required": [
    "role",
    "id"
   ],
   "additionalProperties": false
  },
  "scope": {
   "type": "object",
   "properties": {
    "org_id": {
     "type": "string",
     "pattern": "^o_[A-Za-z0-9-]{8,64}$"
    },
    "participant_id": {
     "type": "string",
     "pattern": "^p_[A-Za-z0-9-]{8,64}$"
    },
    "session_id": {
     "type": "string",
     "pattern": "^s_[A-Za-z0-9-]{8,64}$"
    },
    "prescription_id": {
     "type": "string",
     "pattern": "^rx_[A-Za-z0-9-]{8,64}$"
    },
    "prescription_revision": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000
    },
    "exercise_id": {
     "const": "organizar-a-mesa"
    }
   },
   "required": [
    "org_id",
    "participant_id"
   ],
   "additionalProperties": false
  },
  "source": {
   "type": "object",
   "properties": {
    "type": {
     "type": "string",
     "enum": [
      "camera",
      "simulation",
      "participant_report",
      "therapist",
      "system"
     ]
    },
    "algorithm_version": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9.-]{1,40}$"
    },
    "device_hint": {
     "type": "string",
     "enum": [
      "desktop-chrome",
      "desktop-edge",
      "desktop-other",
      "mobile-chrome",
      "mobile-safari",
      "mobile-other"
     ]
    }
   },
   "required": [
    "type"
   ],
   "additionalProperties": false
  },
  "execution_mode": {
   "type": "string",
   "enum": [
    "camera",
    "simulation",
    "report_only",
    "not_applicable"
   ]
  },
  "data_origin": {
   "type": "string",
   "enum": [
    "live",
    "synthetic_fixture",
    "experimental_capture",
    "imported_v1"
   ]
  },
  "origin_ref": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "hash": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "payload": {
   "type": "object",
   "properties": {
    "participant_id": {
     "type": "string",
     "pattern": "^p_[A-Za-z0-9-]{8,64}$"
    },
    "exercise_id": {
     "const": "organizar-a-mesa"
    },
    "permitted_movement": {
     "const": "hand_open_close"
    },
    "side": {
     "type": "string",
     "enum": [
      "left",
      "right"
     ]
    },
    "target_sets": {
     "type": "integer",
     "minimum": 1,
     "maximum": 10
    },
    "target_repetitions": {
     "type": "integer",
     "minimum": 1,
     "maximum": 100
    },
    "sessions_per_week": {
     "type": "integer",
     "minimum": 1,
     "maximum": 14
    },
    "valid_from": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "valid_to": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timezone": {
     "type": "string",
     "enum": [
      "America/Noronha",
      "America/Sao_Paulo",
      "America/Bahia",
      "America/Fortaleza",
      "America/Recife",
      "America/Maceio",
      "America/Araguaina",
      "America/Belem",
      "America/Santarem",
      "America/Manaus",
      "America/Cuiaba",
      "America/Campo_Grande",
      "America/Porto_Velho",
      "America/Boa_Vista",
      "America/Rio_Branco",
      "America/Eirunepe"
     ]
    },
    "min_calibration_span": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0.22,
     "maximum": 3
    },
    "instructions_ptbr": {
     "type": "string",
     "minLength": 0,
     "maxLength": 500
    },
    "prescription_id": {
     "type": "string",
     "pattern": "^rx_[A-Za-z0-9-]{8,64}$"
    },
    "revision": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000
    },
    "supersedes_revision": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1,
     "maximum": 999
    },
    "created_by": {
     "type": "string",
     "pattern": "^t_[A-Za-z0-9-]{8,64}$"
    },
    "created_at": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "limits_version": {
     "type": "string",
     "pattern": "^limits-v[0-9]{1,3}$"
    }
   },
   "required": [
    "participant_id",
    "exercise_id",
    "permitted_movement",
    "side",
    "target_sets",
    "target_repetitions",
    "sessions_per_week",
    "valid_from",
    "valid_to",
    "timezone",
    "min_calibration_span",
    "instructions_ptbr",
    "prescription_id",
    "revision",
    "supersedes_revision",
    "created_by",
    "created_at",
    "limits_version"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "event_id",
  "schema_version",
  "type",
  "stream_id",
  "seq",
  "prev_hash",
  "occurred_at",
  "actor",
  "scope",
  "source",
  "execution_mode",
  "data_origin",
  "hash",
  "payload"
 ],
 "additionalProperties": false
}
