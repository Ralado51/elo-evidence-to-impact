{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "elo:contracts:3.0.0:fact-proposal.F06",
 "type": "object",
 "properties": {
  "type": {
   "const": "F06"
  },
  "params": {
   "type": "object",
   "properties": {
    "session_id": {
     "type": "string",
     "pattern": "^s_[A-Za-z0-9-]{8,64}$"
    },
    "session_date_local": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "usable_fraction": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "lost_events": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100000
    },
    "fps_mean": {
     "type": "number",
     "minimum": 0,
     "maximum": 240
    },
    "fps_min": {
     "type": "number",
     "minimum": 0,
     "maximum": 240
    },
    "low_capture_quality": {
     "type": "boolean"
    }
   },
   "required": [
    "session_id",
    "session_date_local",
    "usable_fraction",
    "lost_events",
    "fps_mean",
    "fps_min",
    "low_capture_quality"
   ],
   "additionalProperties": false
  },
  "evidence_refs": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[0-9a-f]{64}$"
   },
   "minItems": 1,
   "maxItems": 2000,
   "uniqueItems": true,
   "x-sorted": true
  },
  "scope": {
   "type": "object",
   "properties": {
    "org_id": {
     "type": "string",
     "pattern": "^o_[A-Za-z0-9-]{8,64}$"
    },
    "participant_id": {
     "type": "string",
     "pattern": "^p_[A-Za-z0-9-]{8,64}$"
    },
    "session_id": {
     "type": "string",
     "pattern": "^s_[A-Za-z0-9-]{8,64}$"
    },
    "prescription_id": {
     "type": "string",
     "pattern": "^rx_[A-Za-z0-9-]{8,64}$"
    },
    "prescription_revision": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000
    },
    "exercise_id": {
     "const": "organizar-a-mesa"
    }
   },
   "required": [
    "org_id",
    "participant_id",
    "session_id",
    "prescription_id",
    "prescription_revision",
    "exercise_id"
   ],
   "additionalProperties": false
  },
  "data_origin": {
   "type": "string",
   "enum": [
    "live",
    "synthetic_fixture",
    "experimental_capture",
    "imported_v1"
   ]
  },
  "catalog_version": {
   "const": "2"
  }
 },
 "required": [
  "type",
  "params",
  "evidence_refs",
  "scope",
  "data_origin",
  "catalog_version"
 ],
 "additionalProperties": false
}
