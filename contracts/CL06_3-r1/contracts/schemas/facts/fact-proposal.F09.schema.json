{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "elo:contracts:3.0.0:fact-proposal.F09",
 "type": "object",
 "properties": {
  "type": {
   "const": "F09"
  },
  "params": {
   "type": "object",
   "properties": {
    "session_id": {
     "type": "string",
     "pattern": "^s_[A-Za-z0-9-]{8,64}$"
    },
    "session_date_local": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "calibration_id": {
     "type": "string",
     "pattern": "^cal_[A-Za-z0-9-]{8,64}$"
    },
    "open": {
     "type": "number",
     "minimum": -10,
     "maximum": 10
    },
    "closed": {
     "type": "number",
     "minimum": -10,
     "maximum": 10
    },
    "span": {
     "type": "number",
     "minimum": 0.22,
     "maximum": 20
    },
    "min_span_required": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0.22,
     "maximum": 3
    }
   },
   "required": [
    "session_id",
    "session_date_local",
    "calibration_id",
    "open",
    "closed",
    "span",
    "min_span_required"
   ],
   "additionalProperties": false
  },
  "evidence_refs": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[0-9a-f]{64}$"
   },
   "minItems": 1,
   "maxItems": 2000,
   "uniqueItems": true,
   "x-sorted": true
  },
  "scope": {
   "type": "object",
   "properties": {
    "org_id": {
     "type": "string",
     "pattern": "^o_[A-Za-z0-9-]{8,64}$"
    },
    "participant_id": {
     "type": "string",
     "pattern": "^p_[A-Za-z0-9-]{8,64}$"
    },
    "session_id": {
     "type": "string",
     "pattern": "^s_[A-Za-z0-9-]{8,64}$"
    },
    "prescription_id": {
     "type": "string",
     "pattern": "^rx_[A-Za-z0-9-]{8,64}$"
    },
    "prescription_revision": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000
    },
    "exercise_id": {
     "const": "organizar-a-mesa"
    }
   },
   "required": [
    "org_id",
    "participant_id",
    "session_id",
    "prescription_id",
    "prescription_revision",
    "exercise_id"
   ],
   "additionalProperties": false
  },
  "data_origin": {
   "type": "string",
   "enum": [
    "live",
    "synthetic_fixture",
    "experimental_capture",
    "imported_v1"
   ]
  },
  "catalog_version": {
   "const": "2"
  }
 },
 "required": [
  "type",
  "params",
  "evidence_refs",
  "scope",
  "data_origin",
  "catalog_version"
 ],
 "additionalProperties": false
}
