{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "elo:contracts:3.0.0:fact.F08",
 "type": "object",
 "properties": {
  "fact_id": {
   "type": "string",
   "pattern": "^f_[0-9a-f]{64}$"
  },
  "type": {
   "const": "F08"
  },
  "catalog_version": {
   "const": "2"
  },
  "params": {
   "type": "object",
   "properties": {
    "session_id": {
     "type": "string",
     "pattern": "^s_[A-Za-z0-9-]{8,64}$"
    },
    "session_date_local": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "symptom": {
     "type": "string",
     "enum": [
      "pain",
      "fatigue"
     ]
    }
   },
   "required": [
    "session_id",
    "session_date_local",
    "symptom"
   ],
   "additionalProperties": false
  },
  "evidence_refs": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[0-9a-f]{64}$"
   },
   "minItems": 1,
   "maxItems": 2000,
   "uniqueItems": true,
   "x-sorted": true
  },
  "scope": {
   "type": "object",
   "properties": {
    "org_id": {
     "type": "string",
     "pattern": "^o_[A-Za-z0-9-]{8,64}$"
    },
    "participant_id": {
     "type": "string",
     "pattern": "^p_[A-Za-z0-9-]{8,64}$"
    },
    "session_id": {
     "type": "string",
     "pattern": "^s_[A-Za-z0-9-]{8,64}$"
    },
    "prescription_id": {
     "type": "string",
     "pattern": "^rx_[A-Za-z0-9-]{8,64}$"
    },
    "prescription_revision": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000
    },
    "exercise_id": {
     "const": "organizar-a-mesa"
    }
   },
   "required": [
    "org_id",
    "participant_id",
    "session_id",
    "prescription_id",
    "prescription_revision",
    "exercise_id"
   ],
   "additionalProperties": false
  },
  "data_origin": {
   "type": "string",
   "enum": [
    "live",
    "synthetic_fixture",
    "experimental_capture",
    "imported_v1"
   ]
  },
  "versions": {
   "type": "object",
   "properties": {
    "catalog": {
     "const": "2"
    },
    "verifier": {
     "type": "string",
     "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "algorithm": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[a-z0-9][a-z0-9.-]{1,40}$"
    },
    "definition": {
     "type": "integer",
     "minimum": 1,
     "maximum": 99
    }
   },
   "required": [
    "catalog",
    "verifier",
    "algorithm",
    "definition"
   ],
   "additionalProperties": false
  },
  "limitations": {
   "type": "array",
   "items": {
    "type": "string",
    "enum": [
     "L01",
     "L02",
     "L03",
     "L04",
     "L05",
     "L06",
     "L07",
     "L08",
     "L09",
     "L10",
     "L11",
     "L12",
     "L13",
     "L14",
     "L15",
     "L16",
     "L17",
     "L18",
     "L19"
    ]
   },
   "minItems": 0,
   "maxItems": 19,
   "uniqueItems": true,
   "x-sorted": true
  },
  "rendered": {
   "type": "object",
   "properties": {
    "text_ptbr": {
     "type": "string",
     "minLength": 1,
     "maxLength": 400
    },
    "limitations_ptbr": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
     },
     "minItems": 0,
     "maxItems": 19
    }
   },
   "required": [
    "text_ptbr",
    "limitations_ptbr"
   ],
   "additionalProperties": false
  },
  "flags": {
   "type": "object",
   "properties": {
    "highlight": {
     "type": "boolean"
    },
    "summary_eligible": {
     "type": "boolean"
    }
   },
   "required": [
    "highlight",
    "summary_eligible"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "fact_id",
  "type",
  "catalog_version",
  "params",
  "evidence_refs",
  "scope",
  "data_origin",
  "versions",
  "limitations",
  "rendered",
  "flags"
 ],
 "additionalProperties": false
}
