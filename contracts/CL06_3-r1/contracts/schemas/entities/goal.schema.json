{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "elo:contracts:3.0.0:entity.goal",
 "type": "object",
 "properties": {
  "entity_id": {
   "type": "string",
   "pattern": "^gl_[A-Za-z0-9-]{8,64}$"
  },
  "entity_type": {
   "const": "goal"
  },
  "version": {
   "type": "integer",
   "minimum": 1,
   "maximum": 100000
  },
  "prev_hash": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[0-9a-f]{64}$"
  },
  "org_id": {
   "type": "string",
   "pattern": "^o_[A-Za-z0-9-]{8,64}$"
  },
  "participant_id": {
   "type": "string",
   "pattern": "^p_[A-Za-z0-9-]{8,64}$"
  },
  "created_at": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
  },
  "author": {
   "type": "object",
   "properties": {
    "role": {
     "type": "string",
     "enum": [
      "participant",
      "therapist"
     ]
    },
    "id": {
     "type": "string",
     "pattern": "^(p|t)_[A-Za-z0-9-]{8,64}$"
    }
   },
   "required": [
    "role",
    "id"
   ],
   "additionalProperties": false
  },
  "data_origin": {
   "type": "string",
   "enum": [
    "live",
    "synthetic_fixture",
    "experimental_capture",
    "imported_v1"
   ]
  },
  "origin_ref": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "payload": {
   "type": "object",
   "properties": {
    "goal_text": {
     "type": "string",
     "minLength": 1,
     "maxLength": 300
    },
    "body_segment": {
     "type": "string",
     "enum": [
      "hand",
      "wrist"
     ]
    },
    "target": {
     "type": "object",
     "properties": {
      "kind": {
       "type": "string",
       "enum": [
        "descriptive_text",
        "session_count",
        "repetitions",
        "measure_value"
       ]
      },
      "value": {
       "type": [
        "number",
        "null"
       ],
       "minimum": 0,
       "maximum": 100000
      },
      "unit": {
       "type": [
        "string",
        "null"
       ],
       "pattern": "^[a-z0-9%/.-]{1,12}$"
      }
     },
     "required": [
      "kind",
      "value",
      "unit"
     ],
     "additionalProperties": false
    },
    "status": {
     "type": "string",
     "enum": [
      "active",
      "achieved_confirmed",
      "discontinued"
     ]
    },
    "confirmed_by": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^t_[A-Za-z0-9-]{8,64}$"
    },
    "confirmed_at": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
   },
   "required": [
    "goal_text",
    "body_segment",
    "target",
    "status",
    "confirmed_by",
    "confirmed_at"
   ],
   "additionalProperties": false
  },
  "hash": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  }
 },
 "required": [
  "entity_id",
  "entity_type",
  "version",
  "prev_hash",
  "org_id",
  "participant_id",
  "created_at",
  "author",
  "data_origin",
  "payload",
  "hash"
 ],
 "additionalProperties": false
}
