{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "elo:contracts:3.0.0:entity.reassessment",
 "type": "object",
 "properties": {
  "entity_id": {
   "type": "string",
   "pattern": "^ra_[A-Za-z0-9-]{8,64}$"
  },
  "entity_type": {
   "const": "reassessment"
  },
  "version": {
   "type": "integer",
   "minimum": 1,
   "maximum": 100000
  },
  "prev_hash": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[0-9a-f]{64}$"
  },
  "org_id": {
   "type": "string",
   "pattern": "^o_[A-Za-z0-9-]{8,64}$"
  },
  "participant_id": {
   "type": "string",
   "pattern": "^p_[A-Za-z0-9-]{8,64}$"
  },
  "created_at": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
  },
  "author": {
   "type": "object",
   "properties": {
    "role": {
     "type": "string",
     "enum": [
      "participant",
      "therapist"
     ]
    },
    "id": {
     "type": "string",
     "pattern": "^(p|t)_[A-Za-z0-9-]{8,64}$"
    }
   },
   "required": [
    "role",
    "id"
   ],
   "additionalProperties": false
  },
  "data_origin": {
   "type": "string",
   "enum": [
    "live",
    "synthetic_fixture",
    "experimental_capture",
    "imported_v1"
   ]
  },
  "origin_ref": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "payload": {
   "type": "object",
   "properties": {
    "baseline_assessment_ref": {
     "type": "string",
     "pattern": "^fa_[A-Za-z0-9-]{8,64}$"
    },
    "current_assessment_ref": {
     "type": "string",
     "pattern": "^fa_[A-Za-z0-9-]{8,64}$"
    },
    "item_comparability": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "item_key": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,48}$"
       },
       "comparable": {
        "type": "boolean"
       },
       "reason": {
        "type": [
         "string",
         "null"
        ],
        "enum": [
         "method_differs",
         "unit_differs",
         "protocol_differs",
         "instrument_version_differs",
         "side_differs",
         "segment_differs",
         "other_not_comparable",
         null
        ]
       }
      },
      "required": [
       "item_key",
       "comparable",
       "reason"
      ],
      "additionalProperties": false
     },
     "minItems": 1,
     "maxItems": 200
    }
   },
   "required": [
    "baseline_assessment_ref",
    "current_assessment_ref",
    "item_comparability"
   ],
   "additionalProperties": false
  },
  "hash": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  }
 },
 "required": [
  "entity_id",
  "entity_type",
  "version",
  "prev_hash",
  "org_id",
  "participant_id",
  "created_at",
  "author",
  "data_origin",
  "payload",
  "hash"
 ],
 "additionalProperties": false
}
