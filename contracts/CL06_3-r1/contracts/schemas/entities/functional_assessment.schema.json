{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "elo:contracts:3.0.0:entity.functional_assessment",
 "type": "object",
 "properties": {
  "entity_id": {
   "type": "string",
   "pattern": "^fa_[A-Za-z0-9-]{8,64}$"
  },
  "entity_type": {
   "const": "functional_assessment"
  },
  "version": {
   "type": "integer",
   "minimum": 1,
   "maximum": 100000
  },
  "prev_hash": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[0-9a-f]{64}$"
  },
  "org_id": {
   "type": "string",
   "pattern": "^o_[A-Za-z0-9-]{8,64}$"
  },
  "participant_id": {
   "type": "string",
   "pattern": "^p_[A-Za-z0-9-]{8,64}$"
  },
  "created_at": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
  },
  "author": {
   "type": "object",
   "properties": {
    "role": {
     "type": "string",
     "enum": [
      "participant",
      "therapist"
     ]
    },
    "id": {
     "type": "string",
     "pattern": "^(p|t)_[A-Za-z0-9-]{8,64}$"
    }
   },
   "required": [
    "role",
    "id"
   ],
   "additionalProperties": false
  },
  "data_origin": {
   "type": "string",
   "enum": [
    "live",
    "synthetic_fixture",
    "experimental_capture",
    "imported_v1"
   ]
  },
  "origin_ref": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "payload": {
   "type": "object",
   "properties": {
    "assessment_date": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "body_segment": {
     "type": "string",
     "enum": [
      "hand",
      "wrist"
     ]
    },
    "side": {
     "type": "string",
     "enum": [
      "left",
      "right"
     ]
    },
    "instrument": {
     "type": "object",
     "properties": {
      "instrument_id": {
       "type": "string",
       "pattern": "^[a-z][a-z0-9_]{1,48}$"
      },
      "instrument_version": {
       "type": "string",
       "pattern": "^[0-9A-Za-z._-]{1,20}$"
      },
      "status": {
       "type": "string",
       "enum": [
        "unvalidated_custom",
        "validated_with_therapists"
       ]
      }
     },
     "required": [
      "instrument_id",
      "instrument_version",
      "status"
     ],
     "additionalProperties": false
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "item_key": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,48}$"
       },
       "value_type": {
        "type": "string",
        "enum": [
         "integer",
         "number",
         "category",
         "boolean"
        ]
       },
       "value": {
        "type": [
         "number",
         "string",
         "boolean",
         "null"
        ],
        "maxLength": 80
       },
       "unit": {
        "type": [
         "string",
         "null"
        ],
        "pattern": "^[a-z0-9%/.-]{1,12}$"
       },
       "source": {
        "type": "string",
        "enum": [
         "therapist_observed",
         "therapist_instrumental",
         "participant_reported"
        ]
       },
       "assistance": {
        "type": "string",
        "enum": [
         "none",
         "some",
         "full",
         "not_assessed"
        ]
       },
       "not_assessed": {
        "type": "boolean"
       }
      },
      "required": [
       "item_key",
       "value_type",
       "value",
       "unit",
       "source",
       "assistance",
       "not_assessed"
      ],
      "additionalProperties": false
     },
     "minItems": 1,
     "maxItems": 200
    },
    "therapist_note": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 2000
    }
   },
   "required": [
    "assessment_date",
    "body_segment",
    "side",
    "instrument",
    "items",
    "therapist_note"
   ],
   "additionalProperties": false
  },
  "hash": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  }
 },
 "required": [
  "entity_id",
  "entity_type",
  "version",
  "prev_hash",
  "org_id",
  "participant_id",
  "created_at",
  "author",
  "data_origin",
  "payload",
  "hash"
 ],
 "additionalProperties": false
}
