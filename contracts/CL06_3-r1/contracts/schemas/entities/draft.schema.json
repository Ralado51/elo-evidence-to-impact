{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "elo:contracts:3.0.0:entity.draft",
 "type": "object",
 "properties": {
  "entity_id": {
   "type": "string",
   "pattern": "^dr_[A-Za-z0-9-]{8,64}$"
  },
  "entity_type": {
   "const": "draft"
  },
  "version": {
   "type": "integer",
   "minimum": 1,
   "maximum": 100000
  },
  "prev_hash": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[0-9a-f]{64}$"
  },
  "org_id": {
   "type": "string",
   "pattern": "^o_[A-Za-z0-9-]{8,64}$"
  },
  "participant_id": {
   "type": "string",
   "pattern": "^p_[A-Za-z0-9-]{8,64}$"
  },
  "created_at": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
  },
  "author": {
   "type": "object",
   "properties": {
    "role": {
     "type": "string",
     "enum": [
      "participant",
      "therapist"
     ]
    },
    "id": {
     "type": "string",
     "pattern": "^(p|t)_[A-Za-z0-9-]{8,64}$"
    }
   },
   "required": [
    "role",
    "id"
   ],
   "additionalProperties": false
  },
  "data_origin": {
   "type": "string",
   "enum": [
    "live",
    "synthetic_fixture",
    "experimental_capture",
    "imported_v1"
   ]
  },
  "origin_ref": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "payload": {
   "oneOf": [
    {
     "type": "object",
     "properties": {
      "draft_kind": {
       "type": "string",
       "enum": [
        "dictation_transcript",
        "structured_extraction",
        "session_report_proposal"
       ]
      },
      "target": {
       "type": "string",
       "enum": [
        "encounter",
        "functional_assessment",
        "goal",
        "session_report"
       ]
      },
      "status": {
       "type": "string",
       "enum": [
        "draft",
        "confirmed",
        "discarded"
       ]
      },
      "produced_by": {
       "const": "voice_to_text"
      },
      "retention_class": {
       "type": "string",
       "enum": [
        "session_only",
        "until_confirmed",
        "pending_definition"
       ]
      },
      "transcript_text": {
       "type": [
        "string",
        "null"
       ],
       "maxLength": 8000
      },
      "proposals": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "field_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,48}$"
         },
         "proposed_value": {
          "type": "string",
          "maxLength": 500
         },
         "state": {
          "type": "string",
          "enum": [
           "proposed",
           "missing",
           "ambiguous"
          ]
         }
        },
        "required": [
         "field_key",
         "proposed_value",
         "state"
        ],
        "additionalProperties": false
       },
       "minItems": 0,
       "maxItems": 100
      },
      "audio_retained": {
       "const": false
      },
      "engine_label": {
       "type": [
        "string",
        "null"
       ],
       "maxLength": 60
      },
      "microphone_consent_ref": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "confirmed_entity_ref": {
       "type": [
        "string",
        "null"
       ],
       "pattern": "^(fa|gl|en)_[A-Za-z0-9-]{8,64}$"
      },
      "confirmed_by": {
       "type": [
        "string",
        "null"
       ],
       "pattern": "^(p|t)_[A-Za-z0-9-]{8,64}$"
      }
     },
     "required": [
      "draft_kind",
      "target",
      "status",
      "produced_by",
      "retention_class",
      "transcript_text",
      "proposals",
      "audio_retained",
      "engine_label",
      "microphone_consent_ref",
      "confirmed_entity_ref",
      "confirmed_by"
     ],
     "additionalProperties": false
    },
    {
     "type": "object",
     "properties": {
      "draft_kind": {
       "type": "string",
       "enum": [
        "dictation_transcript",
        "structured_extraction",
        "session_report_proposal"
       ]
      },
      "target": {
       "type": "string",
       "enum": [
        "encounter",
        "functional_assessment",
        "goal",
        "session_report"
       ]
      },
      "status": {
       "type": "string",
       "enum": [
        "draft",
        "confirmed",
        "discarded"
       ]
      },
      "produced_by": {
       "type": "string",
       "enum": [
        "assisted_structuring",
        "manual_form"
       ]
      },
      "retention_class": {
       "type": "string",
       "enum": [
        "session_only",
        "until_confirmed",
        "pending_definition"
       ]
      },
      "transcript_text": {
       "type": [
        "string",
        "null"
       ],
       "maxLength": 8000
      },
      "proposals": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "field_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,48}$"
         },
         "proposed_value": {
          "type": "string",
          "maxLength": 500
         },
         "state": {
          "type": "string",
          "enum": [
           "proposed",
           "missing",
           "ambiguous"
          ]
         }
        },
        "required": [
         "field_key",
         "proposed_value",
         "state"
        ],
        "additionalProperties": false
       },
       "minItems": 0,
       "maxItems": 100
      },
      "audio_retained": {
       "const": false
      },
      "engine_label": {
       "type": [
        "string",
        "null"
       ],
       "maxLength": 60
      },
      "microphone_consent_ref": {
       "type": [
        "string",
        "null"
       ],
       "pattern": "^[0-9a-f]{64}$"
      },
      "confirmed_entity_ref": {
       "type": [
        "string",
        "null"
       ],
       "pattern": "^(fa|gl|en)_[A-Za-z0-9-]{8,64}$"
      },
      "confirmed_by": {
       "type": [
        "string",
        "null"
       ],
       "pattern": "^(p|t)_[A-Za-z0-9-]{8,64}$"
      }
     },
     "required": [
      "draft_kind",
      "target",
      "status",
      "produced_by",
      "retention_class",
      "transcript_text",
      "proposals",
      "audio_retained",
      "engine_label",
      "microphone_consent_ref",
      "confirmed_entity_ref",
      "confirmed_by"
     ],
     "additionalProperties": false
    }
   ]
  },
  "hash": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  }
 },
 "required": [
  "entity_id",
  "entity_type",
  "version",
  "prev_hash",
  "org_id",
  "participant_id",
  "created_at",
  "author",
  "data_origin",
  "payload",
  "hash"
 ],
 "additionalProperties": false
}
