{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "elo:contracts:3.0.0:entity.encounter",
 "type": "object",
 "properties": {
  "entity_id": {
   "type": "string",
   "pattern": "^en_[A-Za-z0-9-]{8,64}$"
  },
  "entity_type": {
   "const": "encounter"
  },
  "version": {
   "type": "integer",
   "minimum": 1,
   "maximum": 100000
  },
  "prev_hash": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[0-9a-f]{64}$"
  },
  "org_id": {
   "type": "string",
   "pattern": "^o_[A-Za-z0-9-]{8,64}$"
  },
  "participant_id": {
   "type": "string",
   "pattern": "^p_[A-Za-z0-9-]{8,64}$"
  },
  "created_at": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
  },
  "author": {
   "type": "object",
   "properties": {
    "role": {
     "type": "string",
     "enum": [
      "participant",
      "therapist"
     ]
    },
    "id": {
     "type": "string",
     "pattern": "^(p|t)_[A-Za-z0-9-]{8,64}$"
    }
   },
   "required": [
    "role",
    "id"
   ],
   "additionalProperties": false
  },
  "data_origin": {
   "type": "string",
   "enum": [
    "live",
    "synthetic_fixture",
    "experimental_capture",
    "imported_v1"
   ]
  },
  "origin_ref": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "payload": {
   "type": "object",
   "properties": {
    "encounter_date": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "modality": {
     "type": "string",
     "enum": [
      "in_person",
      "remote_external"
     ]
    },
    "duration_min": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1,
     "maximum": 600
    },
    "prescription_ref": {
     "type": [
      "object",
      "null"
     ],
     "properties": {
      "prescription_id": {
       "type": "string",
       "pattern": "^rx_[A-Za-z0-9-]{8,64}$"
      },
      "revision": {
       "type": "integer",
       "minimum": 1,
       "maximum": 1000
      }
     },
     "required": [
      "prescription_id",
      "revision"
     ],
     "additionalProperties": false
    },
    "assessment_ref": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^fa_[A-Za-z0-9-]{8,64}$"
    },
    "therapist_note": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 2000
    }
   },
   "required": [
    "encounter_date",
    "modality",
    "duration_min",
    "prescription_ref",
    "assessment_ref",
    "therapist_note"
   ],
   "additionalProperties": false
  },
  "hash": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  }
 },
 "required": [
  "entity_id",
  "entity_type",
  "version",
  "prev_hash",
  "org_id",
  "participant_id",
  "created_at",
  "author",
  "data_origin",
  "payload",
  "hash"
 ],
 "additionalProperties": false
}
