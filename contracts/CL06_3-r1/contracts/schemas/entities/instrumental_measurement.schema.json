{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "elo:contracts:3.0.0:entity.instrumental_measurement",
 "type": "object",
 "properties": {
  "entity_id": {
   "type": "string",
   "pattern": "^im_[A-Za-z0-9-]{8,64}$"
  },
  "entity_type": {
   "const": "instrumental_measurement"
  },
  "version": {
   "type": "integer",
   "minimum": 1,
   "maximum": 100000
  },
  "prev_hash": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[0-9a-f]{64}$"
  },
  "org_id": {
   "type": "string",
   "pattern": "^o_[A-Za-z0-9-]{8,64}$"
  },
  "participant_id": {
   "type": "string",
   "pattern": "^p_[A-Za-z0-9-]{8,64}$"
  },
  "created_at": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
  },
  "author": {
   "type": "object",
   "properties": {
    "role": {
     "type": "string",
     "enum": [
      "participant",
      "therapist"
     ]
    },
    "id": {
     "type": "string",
     "pattern": "^(p|t)_[A-Za-z0-9-]{8,64}$"
    }
   },
   "required": [
    "role",
    "id"
   ],
   "additionalProperties": false
  },
  "data_origin": {
   "type": "string",
   "enum": [
    "live",
    "synthetic_fixture",
    "experimental_capture",
    "imported_v1"
   ]
  },
  "origin_ref": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "payload": {
   "type": "object",
   "properties": {
    "measured_at": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "body_segment": {
     "type": "string",
     "enum": [
      "hand",
      "wrist"
     ]
    },
    "side": {
     "type": "string",
     "enum": [
      "left",
      "right"
     ]
    },
    "movement_key": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]{1,48}$"
    },
    "value": {
     "type": "number",
     "minimum": -10000,
     "maximum": 10000
    },
    "unit": {
     "type": "string",
     "pattern": "^[a-z0-9%/.-]{1,12}$"
    },
    "instrument_label": {
     "type": "string",
     "minLength": 1,
     "maxLength": 60
    },
    "method": {
     "const": "therapist_instrumental_manual"
    },
    "assistance": {
     "type": "string",
     "enum": [
      "none",
      "some",
      "full",
      "not_assessed"
     ]
    },
    "therapist_note": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 500
    }
   },
   "required": [
    "measured_at",
    "body_segment",
    "side",
    "movement_key",
    "value",
    "unit",
    "instrument_label",
    "method",
    "assistance",
    "therapist_note"
   ],
   "additionalProperties": false
  },
  "hash": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  }
 },
 "required": [
  "entity_id",
  "entity_type",
  "version",
  "prev_hash",
  "org_id",
  "participant_id",
  "created_at",
  "author",
  "data_origin",
  "payload",
  "hash"
 ],
 "additionalProperties": false
}
